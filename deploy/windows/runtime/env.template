# DOXamigo clinic install (native Windows). Written once by setup.ps1 into
# <root>\data\.env and copied into the app on every setup/update run.
# Placeholders {{LIKE_THIS}} are filled in by setup.ps1.

APP_NAME=DOXamigo
APP_ENV=production
APP_KEY={{APP_KEY}}
APP_DEBUG=false
APP_TIMEZONE=Africa/Cairo
APP_URL={{APP_URL}}
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Address phones on the clinic Wi-Fi use to reach this PC (Scan paper card).
CLINIC_LAN_URL={{LAN_URL}}

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
DB_DATABASE={{DB_PATH}}

SESSION_DRIVER=database
SESSION_LIFETIME=720
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Central app (license, heartbeat, remote actions).
LICENSE_SERVER_URL={{CENTRAL_URL}}

# Encrypted backups; set a real password at install time.
BACKUP_DELETE_PASSWORD={{BACKUP_PASSWORD}}
